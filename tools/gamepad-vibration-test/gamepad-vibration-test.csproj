<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone manual diagnostic tool, NOT part of the Apollo build or
    install - nothing in CMakeLists.txt references this project, so it's
    never built as part of a normal `cmake build`. Run it directly with
    `dotnet run` on the Windows machine you want to test a gamepad on.

    Drives classic XInputSetState directly (P/Invoke into xinput1_4.dll,
    the same API most PC games use for controller rumble) to cycle the
    two main vibration motors - so you can confirm rumble works at all
    without needing a specific game or the Xbox Accessories app (which
    doesn't recognize third-party/virtual XInput devices). Originally
    used Windows.Gaming.Input.Gamepad instead - switched after finding
    HIDMaestro's own investigation confirming that API never reaches a
    ROOT-enumerated virtual controller regardless of the caller. See the
    note at the top of Program.cs and docs/dev/hidmaestro-backend.md for
    the full story, including why trigger-impulse motors can't be tested
    this way at all (classic XInput has no concept of them).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RootNamespace>GamepadVibrationTest</RootNamespace>
    <AssemblyName>gamepad-vibration-test</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
